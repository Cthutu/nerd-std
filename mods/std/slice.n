pub contains :: fn [T] (slice: []T, value: T) -> bool {
    for i in [0 .. slice.count] {
        on slice[i] == value => return yes
    }
    return no
}

test "contains" {
    assert contains([1, 2, 3], 2) == yes, "Expected 2 to be in the slice"
    assert contains([1, 2, 3], 4) == no, "Expected 4 to not be in the slice"
    assert contains([], 1) == no, "Expected 1 to not be in the empty slice"
    assert contains([1], 1) == yes, "Expected 1 to be in the slice"
    assert contains([1, 2, 3, 4, 5], 5) == yes, "Expected 5 to be in the slice"
}
