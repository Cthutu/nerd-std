on "windows" {

    ffi "kernel32" {
        pub CopyMemory :: RtlCopyMemory (Destination : ^void,
                                         Source      : ^void,
                                         Length      : usize)
        pub MoveMemory :: RtlMoveMemory (Destination : ^void,
                                         Source      : ^void,
                                         Length      : usize)
        pub FillMemory :: RtlFillMemory (Destination : ^void,
                                         Length      : usize,
                                         Fill        : u8)
    }

    -- Win32 scalar types used by window and timing APIs.
    pub BOOL          :: i32
    pub DWORD         :: u32
    pub LARGE_INTEGER :: i64

    -- Win32 virtual key codes.
    pub VK_BACK     :: 0x08
    pub VK_TAB      :: 0x09
    pub VK_RETURN   :: 0x0d
    pub VK_ESCAPE   :: 0x1b
    pub VK_SPACE    :: 0x20
    pub VK_SHIFT    :: 0x10
    pub VK_CONTROL  :: 0x11
    pub VK_MENU     :: 0x12
    pub VK_PRIOR    :: 0x21
    pub VK_NEXT     :: 0x22
    pub VK_END      :: 0x23
    pub VK_HOME     :: 0x24
    pub VK_LEFT     :: 0x25
    pub VK_UP       :: 0x26
    pub VK_RIGHT    :: 0x27
    pub VK_DOWN     :: 0x28
    pub VK_INSERT   :: 0x2d
    pub VK_DELETE   :: 0x2e
    pub VK_NUMPAD0  :: 0x60
    pub VK_NUMPAD1  :: 0x61
    pub VK_NUMPAD2  :: 0x62
    pub VK_NUMPAD3  :: 0x63
    pub VK_NUMPAD4  :: 0x64
    pub VK_NUMPAD5  :: 0x65
    pub VK_NUMPAD6  :: 0x66
    pub VK_NUMPAD7  :: 0x67
    pub VK_NUMPAD8  :: 0x68
    pub VK_NUMPAD9  :: 0x69
    pub VK_MULTIPLY :: 0x6a
    pub VK_ADD      :: 0x6b
    pub VK_SUBTRACT :: 0x6d
    pub VK_DECIMAL  :: 0x6e
    pub VK_DIVIDE   :: 0x6f
    pub VK_F1       :: 0x70
    pub VK_F2       :: 0x71
    pub VK_F3       :: 0x72
    pub VK_F4       :: 0x73
    pub VK_F5       :: 0x74
    pub VK_F6       :: 0x75
    pub VK_F7       :: 0x76
    pub VK_F8       :: 0x77
    pub VK_F9       :: 0x78
    pub VK_F10      :: 0x79
    pub VK_F11      :: 0x7a
    pub VK_F12      :: 0x7b
    pub VK_LSHIFT   :: 0xa0
    pub VK_RSHIFT   :: 0xa1
    pub VK_LCONTROL :: 0xa2
    pub VK_RCONTROL :: 0xa3
    pub VK_LMENU    :: 0xa4
    pub VK_RMENU    :: 0xa5

    ffi "kernel32" {
        pub QueryPerformanceCounter   (lpPerformanceCount: ^LARGE_INTEGER) -> BOOL
        pub QueryPerformanceFrequency (lpFrequency: ^LARGE_INTEGER) -> BOOL
        pub Sleep                     (dwMilliseconds: DWORD)
    }

}
